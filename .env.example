# ZimHealth CPD — Environment (example)
# - This file is designed so you change host/domain once, and derived values follow.
# - `${VAR}` expansion is supported by Docker Compose and (commonly) by Node/Prisma tooling.

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Base host / domain (change these once per environment) ───────────────────
APP_SCHEME=http
APP_HOST=localhost

# ─── Public URLs (derived) ────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=4000
BOT_PORT=4100

WEB_URL=${APP_SCHEME}://${APP_HOST}:${WEB_PORT}
API_URL=${APP_SCHEME}://${APP_HOST}:${API_PORT}
BOT_URL=${APP_SCHEME}://${APP_HOST}:${BOT_PORT}

# Vite (web) only exposes variables prefixed with `VITE_`.
VITE_API_URL=${API_URL}
VITE_WEB_URL=${WEB_URL}

# Expo (mobile) only exposes variables prefixed with `EXPO_PUBLIC_`.
# For Android emulator use http://10.0.2.2:4000, iOS sim use http://localhost:4000.
# See apps/mobile/.env.example for device-specific notes.
EXPO_PUBLIC_API_URL=${API_URL}

# ─── CORS (backend) ──────────────────────────────────────────────────────────
# Comma-separated list. Keep it derived so you don’t repeat hostnames.
# Also include Vite dev server origin for local development.
CORS_ORIGINS=${WEB_URL},${APP_SCHEME}://${APP_HOST}:5173

# ─── Database (local dev via docker-compose) ─────────────────────────────────
POSTGRES_HOST=${APP_HOST}
POSTGRES_PORT=5432
POSTGRES_DB=zimhealth
POSTGRES_USER=zimhealth
POSTGRES_PASSWORD=zimhealth_dev

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Redis (local dev via docker-compose) ────────────────────────────────────
REDIS_HOST=${APP_HOST}
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── AI (multi-provider client) ──────────────────────────────────────────────
# Used by `packages/ai-client` (Anthropic, OpenAI/ChatGPT, Gemini, Ollama)
AI_PROVIDER_DEFAULT=anthropic
AI_FEATURES_ENABLED=true

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# OpenAI (ChatGPT / GPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: for Azure OpenAI / proxies (leave empty for default OpenAI API)
OPENAI_BASE_URL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Ollama (local/self-hosted)
OLLAMA_SCHEME=http
OLLAMA_HOST=${APP_HOST}
OLLAMA_PORT=11434
OLLAMA_BASE_URL=${OLLAMA_SCHEME}://${OLLAMA_HOST}:${OLLAMA_PORT}
OLLAMA_MODEL=llama3

# ─── WhatsApp / Twilio ───────────────────────────────────────────────────────
# Choose WhatsApp transport:
# - meta: Meta WhatsApp Cloud API (recommended primary)
# - 360dialog: 360dialog hosted WhatsApp BSP (recommended fallback)
# - twilio: legacy/dev
WHATSAPP_PROVIDER=meta

# Shared webhook verification token (Meta uses this for GET /webhook verification)
WHATSAPP_VERIFY_TOKEN=change-me

# Meta WhatsApp Cloud API (primary)
META_WA_TOKEN=EAAG...
META_WA_PHONE_NUMBER_ID=123456789012345
# If you prefer a provider-specific name, WHATSAPP_VERIFY_TOKEN is enough:
META_WA_VERIFY_TOKEN=${WHATSAPP_VERIFY_TOKEN}

# 360dialog (fallback)
D360_API_KEY=...
# Usually https://waba.360dialog.io
D360_BASE_URL=https://waba.360dialog.io

# Twilio (legacy/dev sandbox)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Sandbox FROM number is always Twilio's shared sandbox: whatsapp:+14155238886
# Your purchased Twilio number is for SMS/voice only
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Internal service secret (backend validates this for bot-to-API calls)
BOT_SECRET=change-me-to-a-long-secret

# ─── Media storage (AWS S3 / Cloudflare R2) ──────────────────────────────────
S3_BUCKET_NAME=zimhealth-media
S3_REGION=af-south-1
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
# Optional S3-compatible endpoint (use for MinIO/R2)
# Example (local MinIO): http://127.0.0.1:9000
S3_ENDPOINT=
CDN_BASE_URL=https://media.zimhealthcpd.co.zw
FFMPEG_PATH=
FFPROBE_PATH=
# Use an ABSOLUTE path. Relative paths fail when the Bull worker resolves from a different CWD.
# Local macOS dev without native LibreOffice: point to the Docker wrapper script.
# Example: LIBREOFFICE_PATH=/absolute/path/to/project/scripts/soffice-docker.sh
LIBREOFFICE_PATH=
MEDIA_PROCESSING_CONCURRENCY=1
MEDIA_PROCESSING_MAX_ATTEMPTS=3
MEDIA_PROCESSING_RETRY_DELAY_MS=5000
MEDIA_MAX_UPLOAD_MB=2048
MEDIA_MAX_IMAGE_MB=5
MEDIA_MAX_VIDEO_MB=2048
MEDIA_MAX_AUDIO_MB=200
MEDIA_MAX_PDF_MB=50
MEDIA_MAX_DOCX_MB=50
MEDIA_MAX_PPTX_MB=100
MEDIA_MAX_TEXT_MB=10
MEDIA_MAX_ARCHIVE_MB=500
MEDIA_MAX_DURATION_SECONDS=7200
MEDIA_ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/x-m4v
MEDIA_ENABLE_MULTI_RESOLUTION=true
MEDIA_TRANSCODE_PRESET=veryfast
MEDIA_THUMBNAIL_AT_SECONDS=5
MEDIA_TEMP_DIR=

# Local MinIO (docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Guideline ingestion ─────────────────────────────────────────────────────
GUIDELINE_FETCH_TIMEOUT_MS=15000
GUIDELINE_MAX_DOWNLOAD_MB=20

# ─── Payments ────────────────────────────────────────────────────────────────
PAYNOW_INTEGRATION_ID=...
PAYNOW_INTEGRATION_KEY=...
PAYNOW_RESULT_URL=${API_URL}/api/payments/webhook/paynow
PAYNOW_RETURN_URL=${WEB_URL}/subscription/success
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=${WEB_URL}/subscription/success
STRIPE_CANCEL_URL=${WEB_URL}/subscription

# ─── Email (SendGrid / SMTP) ─────────────────────────────────────────────────
# Either set SMTP_URL, or set the host/user/pass fields below.
SMTP_URL=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG....
MAIL_FROM=ZimHealth CPD <no-reply@zimhealthcpd.co.zw>
FROM_EMAIL=no-reply@zimhealthcpd.co.zw
SUPPORT_EMAIL=support@zimhealthcpd.co.zw

# ─── Council Sync ────────────────────────────────────────────────────────────
COUNCIL_SYNC_API_URL=https://council-api.example/v1
COUNCIL_SYNC_API_KEY=...
COUNCIL_SYNC_SCHEDULE=0 2 * * *

# ─── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/yyy
VITE_SENTRY_DSN=https://xxx@sentry.io/yyy
