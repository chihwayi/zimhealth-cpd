# pnpm workspace config.
#
# node-linker=hoisted: Expo/React Native's Android and iOS autolinking
# scripts walk node_modules with plain Node `require.resolve()` calls that
# don't understand pnpm's default symlinked/isolated node_modules layout —
# this is Expo's own documented fix for pnpm monorepos
# (https://docs.expo.dev/guides/monorepos/#pnpm-workspaces). Without it,
# EAS Android builds fail at the Gradle step with
# "cannot find symbol: class ExpoModulesPackage" even though the JS side
# resolves fine. Backend/web don't rely on pnpm's stricter isolation for
# anything, so this is safe workspace-wide.
node-linker=hoisted
