# ZimHealth CPD — Mobile app environment
# Copy this file to .env and fill in the values for your environment.
# EXPO_PUBLIC_* variables are inlined by Metro at bundle time (Expo SDK 49+).

# ─── API ──────────────────────────────────────────────────────────────────────
# Use platform-specific values for local simulator/emulator development.
EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:4000
EXPO_PUBLIC_API_URL_IOS=http://localhost:4000

# Use the generic value for physical devices or production builds.
# EXPO_PUBLIC_API_URL=http://192.168.1.x:4000
# EXPO_PUBLIC_API_URL=https://api.zimhealthcpd.co.zw
