# ZimHealth CPD — Mobile app environment
# Copy this file to .env and fill in the values for your environment.
# EXPO_PUBLIC_* variables are inlined by Metro at bundle time (Expo SDK 49+).

# ─── API ──────────────────────────────────────────────────────────────────────
# Android emulator → host machine localhost:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
#
# iOS simulator → host machine localhost:
# EXPO_PUBLIC_API_URL=http://localhost:4000
#
# Physical device on same Wi-Fi (replace with your machine's local IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.x:4000
#
# Production:
# EXPO_PUBLIC_API_URL=https://api.zimhealthcpd.co.zw

EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
