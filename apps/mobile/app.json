{
  "expo": {
    "name": "CPD Hub",
    "slug": "zimhealth-cpd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "scheme": "zimhealth",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#150a26",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "zw.co.zimhealthcpd.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#150a26"
      },
      "package": "zw.co.zimhealthcpd.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "platforms": ["ios", "android"],
    "plugins": ["expo-font", "expo-secure-store", "expo-sqlite", "expo-background-fetch"]
  }
}
