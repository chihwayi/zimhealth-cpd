generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  CONTENT_MANAGER
  NCZ_OFFICER
  COUNCIL_OFFICER
  LEARNER
  HELPDESK
}

enum IssueSource {
  WEB
  MOBILE
  WHATSAPP
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SubscriptionTier {
  FREE
  STANDARD
  INSTITUTION
  DIASPORA
}

enum Cadre {
  NURSE
  MIDWIFE
  PHARMACIST
  CLINICAL_OFFICER
  LAB_TECH
}

enum CourseStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
}

enum CPDCategory {
  CLINICAL
  MANAGEMENT
  ETHICS
  RESEARCH
}

enum SpecialtyTrack {
  MIDWIFERY
  NURSING_EDUCATION
  NURSING_ADMINISTRATION
  OPERATING_THEATRE
  MENTAL_HEALTH
  PEDIATRIC
  GENERAL_REFRESHER
  NURSING_RESEARCH
  DATA_ANALYTICS
  HEALTH_INFORMATICS
  DATA_PROTECTION
  ENTREPRENEURSHIP
}

enum Difficulty {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
}

enum Language {
  ENGLISH
  SHONA
  NDEBELE
}

enum ContentType {
  VIDEO
  READING
  AUDIO
  INTERACTIVE
  QUIZ
}

enum MediaAssetStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MATCHING
  IMAGE_MCQ
}

enum ActivityType {
  VIDEO_WATCH
  QUIZ_PASS
  READING
  WEBINAR
  WHATSAPP_QUIZ
}

enum NczSyncStatus {
  PENDING
  BLOCKED_MISSING_NCZ
  SYNCED
  FAILED
}

enum CouncilCourseReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                    String           @id @default(cuid())
  email                 String           @unique
  passwordHash          String
  fullName              String
  role                  Role             @default(LEARNER)
  councilId             String?
  council               Council?         @relation(fields: [councilId], references: [id])
  professionalTitle     String?
  registrationNumber    String?          @unique
  cadre                 Cadre?
  nczRegistrationNumber String?          @unique
  institution           String?
  province              String?
  district              String?
  phone                 String?          @unique
  avatarUrl             String?
  specialtyArea         String?
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
  subscriptionTier      SubscriptionTier @default(FREE)
  subscriptionExpiresAt DateTime?
  isActive              Boolean          @default(true)
  isApproved            Boolean          @default(true) // false for new CONTENT_MANAGER until Admin approves
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Relations
  coursesCreated   Course[]       @relation("CourseCreator")
  enrollments      Enrollment[]
  cpdRecords       CPDRecord[]
  certificates     Certificate[]
  quizAttempts     QuizAttempt[]
  nczFlags         NczFlag[]
  auditLogs        AuditLog[]
  councilCourseReviewsReviewed CouncilCourseReview[] @relation("CouncilCourseReviewedBy")
  voucherBatchesCreated        VoucherBatch[]         @relation("VoucherBatchCreator")
  voucherBatchesAdministered   VoucherBatch[]         @relation("VoucherBatchInstitutionContact")
  vouchersRedeemed             Voucher[]              @relation("VoucherRedeemer")
  issuesReported                IssueReport[]         @relation("IssueReporter")
  issuesAssigned                IssueReport[]         @relation("IssueAssignee")
  languagePacksUploaded         LanguagePack[]        @relation("LanguagePackUploader")

  @@index([email])
  @@index([nczRegistrationNumber])
  @@index([registrationNumber])
  @@index([councilId])
  @@index([role])
}

model Council {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  acronym            String   @unique
  // ISO 3166-1 alpha-2 (e.g. "ZW", "ZM", "NA") — enables country-scoped
  // council selection as the platform expands beyond Zimbabwe.
  countryCode        String   @default("ZW")
  countryName        String   @default("Zimbabwe")
  requiredPoints     Int      @default(12)
  renewalMonth       Int      @default(12)
  renewalDay         Int      @default(31)
  registrationPrefix String?
  allowedTitles      String[]
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users User[]
  courseReviews CouncilCourseReview[]

  @@index([isActive])
  @@index([name])
  @@index([countryCode])
}

model Course {
  id                 String       @id @default(cuid())
  title              String
  subtitle           String?
  description        String
  thumbnailUrl       String?
  promoVideoUrl      String?
  category           CPDCategory
  isPublicToAll      Boolean      @default(false)
  targetCadres       String[]
  targetCouncilIds   String[]     @default([])
  targetTitles       String[]     @default([])
  specialtyTrack     SpecialtyTrack?
  difficulty         Difficulty   @default(FOUNDATION)
  language           Language     @default(ENGLISH)
  // Legacy field: council-specific points now live in CouncilCourseReview.points.
  // Keep a default for backwards compatibility until all callers migrate.
  cpdPoints          Int         @default(0)
  estimatedMinutes   Int
  accreditationBody  String?
  tags               String[]
  aiSourceName        String?
  aiGeneratedAt       DateTime?
  aiGeneratedProvider String?
  aiReviewNotes       String?
  status             CourseStatus @default(DRAFT)
  expiresAt          DateTime?
  priceOverride      Decimal?
  creatorId          String
  creator            User         @relation("CourseCreator", fields: [creatorId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  modules     Module[]
  enrollments Enrollment[]
  cpdRecords  CPDRecord[]
  reviews     CourseReview[]
  councilReviews CouncilCourseReview[]

  @@index([status])
  @@index([creatorId])
  @@index([category])
  @@index([specialtyTrack])
}

model CouncilCourseReview {
  id              String                   @id @default(cuid())
  courseId        String
  councilId       String
  status          CouncilCourseReviewStatus @default(PENDING_REVIEW)
  points          Int?
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  course          Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  council         Council @relation(fields: [councilId], references: [id], onDelete: Cascade)
  reviewedBy      User?   @relation("CouncilCourseReviewedBy", fields: [reviewedByUserId], references: [id])

  @@unique([courseId, councilId])
  @@index([councilId, status])
  @@index([courseId, status])
}

model Module {
  id             String  @id @default(cuid())
  courseId       String
  course         Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title          String
  order          Int
  isOfflineReady Boolean @default(false)

  sections ContentSection[]
  quizzes  Quiz[]

  @@index([courseId])
  @@unique([courseId, order])
}

model ContentSection {
  id                  String      @id @default(cuid())
  moduleId            String
  module              Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type                ContentType
  title               String
  order               Int
  content             String      // rich text or URL
  mediaUrl            String?
  mediaKey            String?     // S3 key
  completionThreshold Float       @default(0.8) // 80% watch time for video
  createdAt           DateTime    @default(now())

  @@index([moduleId])
}

model Quiz {
  id                 String   @id @default(cuid())
  moduleId           String?
  module             Module?  @relation(fields: [moduleId], references: [id])
  courseId           String
  title              String
  passMark           Float    @default(0.7) // 70%
  attemptLimit       Int      @default(3)
  timeLimitMinutes   Int?
  randomiseQuestions Boolean  @default(false)
  showAnswersAfter   Boolean  @default(true)
  createdAt          DateTime @default(now())

  questions    Question[]
  quizAttempts QuizAttempt[]
  cpdRecords   CPDRecord[]
}

model Question {
  id            String       @id @default(cuid())
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type          QuestionType
  text          String
  imageUrl      String?
  points        Int          @default(1)
  difficultyTag String?
  topicTag      String?
  order         Int
  createdAt     DateTime     @default(now())

  options QuestionOption[]

  @@index([quizId])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
}

model QuizAttempt {
  id          String   @id @default(cuid())
  learnerId   String
  learner     User     @relation(fields: [learnerId], references: [id])
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  score       Float
  passed      Boolean
  answers     Json     // { questionId: optionId }
  completedAt DateTime @default(now())

  @@index([learnerId, quizId])
}

model Enrollment {
  id                String   @id @default(cuid())
  learnerId         String
  learner           User     @relation(fields: [learnerId], references: [id])
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id])
  enrolledAt        DateTime @default(now())
  completedAt       DateTime?
  progress          Float    @default(0) // 0–1, auto-calculated from completedSections
  completedSections String[] @default([]) // section IDs marked complete
  lastAccessAt      DateTime?

  @@unique([learnerId, courseId])
  @@index([learnerId])
}

model CPDRecord {
  id               String       @id @default(cuid())
  learnerId        String
  learner          User         @relation(fields: [learnerId], references: [id])
  courseId         String?
  course           Course?      @relation(fields: [courseId], references: [id])
  quizId           String?
  quiz             Quiz?        @relation(fields: [quizId], references: [id])
  sourceAttemptKey String?      // bot/offline attempt dedupe/audit key
  nczSyncStatus    NczSyncStatus @default(PENDING)
  nczLastError     String?
  nczLastAttemptAt DateTime?
  activityType     ActivityType
  pointsEarned     Int
  quizScore        Float?
  completedAt      DateTime     @default(now())
  cycleYear        Int
  syncedToNcz      Boolean      @default(false)
  nczSyncedAt      DateTime?
  isManualOverride Boolean      @default(false)
  overrideNote     String?
  nczSyncMetadata  Json?
  nczIdempotencyKey String?
  nczNextRetryAt   DateTime?

  @@index([learnerId, cycleYear])
  @@index([learnerId, quizId, cycleYear])
  @@index([learnerId, sourceAttemptKey, cycleYear])
  @@index([syncedToNcz])
  @@index([nczIdempotencyKey])
}

model Certificate {
  id               String   @id @default(cuid())
  learnerId        String
  learner          User     @relation(fields: [learnerId], references: [id])
  certificateUuid  String   @unique @default(uuid())
  cycleYear        Int
  totalPoints      Int
  coursesCompleted String[]
  issuedAt         DateTime @default(now())
  pdfUrl           String?
  pdfKey           String?  // S3 key

  @@index([learnerId])
  @@index([certificateUuid])
}

model CourseReview {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  learnerId String
  rating    Int      // 1–5
  comment   String?
  createdAt DateTime @default(now())

  @@unique([courseId, learnerId])
}

model MediaAsset {
  id                  String           @id @default(cuid())
  ownerId             String
  s3Key               String           @unique
  cdnUrl              String
  fileName            String
  mimeType            String
  sizeBytes           BigInt
  width               Int?
  height              Int?
  durationSecs        Int?
  isProcessed         Boolean          @default(false)
  status              MediaAssetStatus @default(UPLOADED)
  processedS3Key      String?
  processedCdnUrl     String?
  thumbnailS3Key      String?
  thumbnailCdnUrl     String?
  processingError     String?
  processingAttempts  Int              @default(0)
  processingStartedAt DateTime?
  processedAt         DateTime?
  variants            Json?
  createdAt           DateTime         @default(now())

  @@index([ownerId, createdAt])
  @@index([status, createdAt])
}

model NczFlag {
  id        String   @id @default(cuid())
  learnerId String
  learner   User     @relation(fields: [learnerId], references: [id])
  officerId String
  note      String
  createdAt DateTime @default(now())

  @@index([learnerId])
}

model NczSyncLog {
  id           String   @id @default(cuid())
  triggeredBy  String?  // userId or "cron"
  recordCount  Int
  success      Boolean
  errorMessage String?
  dryRun       Boolean  @default(false)
  meta         Json?
  syncedAt     DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// UI translation packs — English ships built into the web app as a static
// bundle (always available, no network dependency). Any other language is a
// DB row: upload a CSV/JSON/XLSX of key->translation pairs via
// /api/locales and it's immediately servable, no code change or redeploy
// needed. See Sprint 09 / docs/integrations/localization.md.
model LanguagePack {
  id           String   @id @default(cuid())
  code         String   @unique // BCP-47-ish, e.g. "sn", "nd", "fr"
  name         String   // display name, e.g. "Shona", "Ndebele", "Français"
  // ISO 3166-1 alpha-2 countries this language is recommended for in the
  // switcher (informational only — any user can still pick any active pack).
  countryCodes String[] @default([])
  translations Json     // flat { "nav.dashboard": "...", ... } key/value map
  isActive     Boolean  @default(true)
  uploadedById String?
  uploadedBy   User?    @relation("LanguagePackUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([countryCodes])
}

model IssueReport {
  id              String        @id @default(cuid())
  reporterId      String?
  reporter        User?         @relation("IssueReporter", fields: [reporterId], references: [id])
  // Fallback contact for WhatsApp reporters who aren't registered yet.
  reporterContact String?
  source          IssueSource
  title           String
  description     String
  status          IssueStatus   @default(OPEN)
  priority        IssuePriority @default(MEDIUM)
  assignedToUserId String?
  assignedTo      User?         @relation("IssueAssignee", fields: [assignedToUserId], references: [id])
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([createdAt])
}

model Subscription {
  id         String           @id @default(cuid())
  learnerId  String           @unique
  tier       SubscriptionTier
  startsAt   DateTime
  expiresAt  DateTime
  paymentRef String?
  gateway    String?          // "paynow" | "stripe"
  createdAt  DateTime         @default(now())
}

// ─── Voucher / Sponsored access ───────────────────────────────────────────────

model VoucherBatch {
  id          String           @id @default(cuid())
  name        String           // human label, e.g. "UNICEF Q1 2026 – Standard"
  sponsorName String           // e.g. "UNICEF Zimbabwe"
  tier        SubscriptionTier
  totalCount  Int              // number of codes generated in this batch
  createdById String
  createdBy   User             @relation("VoucherBatchCreator", fields: [createdById], references: [id])
  // Non-admin user (e.g. an institution's HR/training contact) who can view
  // this batch's roster without being a global ADMIN. Set by the admin who
  // creates the batch on the institution's behalf — see Sprint 07.
  institutionContactId String?
  institutionContact    User?   @relation("VoucherBatchInstitutionContact", fields: [institutionContactId], references: [id])
  expiresAt   DateTime?        // optional: all codes in batch expire at this date
  notes       String?          // internal notes for admin
  createdAt   DateTime         @default(now())
  vouchers    Voucher[]

  @@index([createdById])
  @@index([createdAt])
  @@index([institutionContactId])
}

model Voucher {
  id           String           @id @default(cuid())
  code         String           @unique  // e.g. "ZHCPD-A3K7-V9MQ-B4NP"
  batchId      String
  // Pre-assigned invitee, set by a bulk institution invite before redemption
  // (Sprint 07) — lets the roster show pending invitees, not just redeemed ones.
  inviteeEmail String?
  inviteePhone String?
  batch        VoucherBatch     @relation(fields: [batchId], references: [id])
  tier         SubscriptionTier
  redeemedById String?
  redeemedBy   User?            @relation("VoucherRedeemer", fields: [redeemedById], references: [id])
  redeemedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([batchId])
  @@index([redeemedById])
}
